# Python environments and caches (recreate from requirements.txt)
.venv/
.venv-tf/
__pycache__/
*.pyc
cache/

# The ESC-50 dataset is not ours to redistribute (CC BY-NC). Download it from
# https://github.com/karolpiczak/ESC-50 into data/esc50_raw/
data/

# Large generated files and logs (regenerate with the scripts)
results/*.npy
results/*.npz
*.log

# Gradio writes its own certificate here when sharing
.gradio/

# Intermediate files (regenerated by the scripts)
results/clip_scores.csv
results/clip_stats.csv
results/mixture_meta.json
